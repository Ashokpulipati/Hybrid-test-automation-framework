<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="All Test Suite">
    <groups>
        <run>
            <include name="smoke"/>
        </run>
    </groups>
    <listeners>
        <listener class-name="com.test.listener.TestListener"/>
    </listeners>
    <test name="Smoke suite - All Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.test.tests.LoginTest"/>
            <class name="com.test.tests.LogoutTest"/>
        </classes>
    </test>
</suite>